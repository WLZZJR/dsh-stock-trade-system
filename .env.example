# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Local-only development credentials below; use different values anywhere else.

# Required
# GEI_POSTGRES_PASSWORD is used by docker-compose.dev.yml; keep in sync with GEI_DATABASE_URL
GEI_POSTGRES_PASSWORD=change-me
GEI_DATABASE_URL=postgresql://gei:change-me@localhost:5432/gei
# Redis as seen from the HOST (integration tests, scripts). With an external Redis that
# requires auth, embed the password here; a trailing /N selects a Redis DB index.
GEI_REDIS_URL=redis://localhost:6379/0

# Redis source for the api CONTAINER:
# - bundled Redis (default): keep COMPOSE_PROFILES=bundled; GEI_REDIS_URL_API then falls back
#   to the compose default redis://redis:6379/0 — no extra setting needed.
# - external/shared Redis on the host: comment out COMPOSE_PROFILES and set GEI_REDIS_URL_API,
#   e.g. redis://:password@host.docker.internal:6379/5 (password lives in .env only).
COMPOSE_PROFILES=bundled
# GEI_REDIS_URL_API=redis://:password@host.docker.internal:6379/5

# Optional overrides of configs/default.yaml
# GEI_ENV=dev
# GEI_LOG_LEVEL=INFO
# GEI_SESSION_TTL_MINUTES=720

# Optional: first owner password for `make create-owner` (otherwise you are prompted).
# Do not keep it in .env after the owner exists.
# GEI_OWNER_PASSWORD=
