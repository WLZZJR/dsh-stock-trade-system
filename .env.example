# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Local-only development credentials below; use different values anywhere else.

# Required
# GEI_POSTGRES_PASSWORD is used by docker-compose.dev.yml; keep in sync with GEI_DATABASE_URL
GEI_POSTGRES_PASSWORD=change-me
GEI_DATABASE_URL=postgresql://gei:change-me@localhost:5432/gei
GEI_REDIS_URL=redis://localhost:6379/0

# Optional overrides of configs/default.yaml
# GEI_ENV=dev
# GEI_LOG_LEVEL=INFO
